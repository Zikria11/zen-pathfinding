import argparse, csv, heapq, math, multiprocessing as mp, os, random, time
from collections import deque

try:
    import pandas as pd
    import matplotlib.pyplot as plt
    import seaborn as sns
except Exception as e:
    raise RuntimeError("Install pandas, matplotlib, and seaborn: pip install pandas matplotlib seaborn") from e

DEFAULT_MAPS = 100  
DEFAULT_SIZE = 30
DEFAULT_BASE_PROB = 0.25  
DEFAULT_CLUSTER_PROB = 0.05
DEFAULT_WORKERS = max(1, mp.cpu_count() - 1)
BASE_SEED = 12345
MAX_EXPANSIONS_FACTOR = 4

RESULTS_CSV = "results.csv"
SUMMARY_CSV = "summary.csv"
PLOTS_PNG = "summary_plots.png"

MOVES = [(1,0),(-1,0),(0,1),(0,-1)]

def manhattan(a,b):
    return abs(a[0]-b[0]) + abs(a[1]-b[1])

def neighbors(node, grid):
    x,y = node
    n = len(grid)
    for dx, dy in MOVES:
        nx, ny = x+dx, y+dy
        if 0 <= nx < n and 0 <= ny < n and grid[ny][nx]==0:
            yield (nx, ny)

def reconstruct(came, start, goal):
    if goal not in came:
        return []
    cur = goal
    path = [cur]
    while cur != start:
        cur = came.get(cur)
        if cur is None:
            return []
        path.append(cur)
    path.reverse()
    return path

def make_risky_grid_safe(n, base_prob=0.25, cluster_prob=0.05, seed=None):
    rng = random.Random(seed)
    grid = [[0 if rng.random() > base_prob else 1 for _ in range(n)] for _ in range(n)]

    num_clusters = max(1, int(n*n*cluster_prob/9))
    for _ in range(num_clusters):
        cx, cy = rng.randint(1,n-2), rng.randint(1,n-2)
        for dx in [-1,0,1]:
            for dy in [-1,0,1]:
                nx, ny = cx+dx, cy+dy
                if 0 <= nx < n and 0 <= ny < n:
                    grid[ny][nx] = 1

    for i in range(n):
        grid[i][0] = 0
        grid[i][n-1] = 0
    for j in range(n):
        grid[0][j] = 0
        grid[n-1][j] = 0

    grid[0][0] = 0
    grid[n-1][n-1] = 0
    return grid

def precompute_risk_map(grid, depth=2):
    nrows, ncols = len(grid), len(grid[0])
    risk_map = [[0]*ncols for _ in range(nrows)]
    for y in range(nrows):
        for x in range(ncols):
            score = 0
            for dy in range(-depth, depth+1):
                for dx in range(-depth, depth+1):
                    ny, nx = y+dy, x+dx
                    if not (0<=ny<nrows and 0<=nx<ncols) or grid[ny][nx]==1:
                        score +=1
            risk_map[y][x] = score
    return risk_map

def bfs_search(grid, start, goal, cap, risk_map=None):
    t0 = time.perf_counter()
    q = deque([start])
    came = {start: None}
    visited = set([start])
    expansions = 0
    while q:
        cur = q.popleft()
        expansions +=1
        if cur==goal:
            path = reconstruct(came, start, goal)
            path_risk = sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path), len(visited), 1, 0, (time.perf_counter()-t0)*1000, path_risk
        for nb in neighbors(cur, grid):
            if nb not in visited:
                visited.add(nb)
                came[nb]=cur
                q.append(nb)
        if expansions>cap: break
    return 0, len(visited),0,0,(time.perf_counter()-t0)*1000,0

def dfs_search(grid,start,goal,cap,risk_map=None):
    t0=time.perf_counter()
    stack=[start]
    came={start:None}
    visited=set([start])
    expansions=0
    while stack:
        cur=stack.pop()
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            if nb not in visited:
                visited.add(nb)
                came[nb]=cur
                stack.append(nb)
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0

def dijkstra_search(grid,start,goal,cap,risk_map=None):
    t0=time.perf_counter()
    pq=[(0,start)]
    dist={start:0}
    came={start:None}
    visited=set()
    expansions=0
    while pq:
        d,cur=heapq.heappop(pq)
        if cur in visited: continue
        visited.add(cur)
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            nd=d+1
            if nb not in dist or nd<dist[nb]:
                dist[nb]=nd
                came[nb]=cur
                heapq.heappush(pq,(nd,nb))
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0

def greedy_search(grid,start,goal,cap,risk_map=None):
    t0=time.perf_counter()
    pq=[(manhattan(start,goal),start)]
    came={start:None}
    visited=set()
    seen={start}
    expansions=0
    while pq:
        _,cur=heapq.heappop(pq)
        if cur in visited: continue
        visited.add(cur)
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            if nb not in seen:
                seen.add(nb)
                came[nb]=cur
                heapq.heappush(pq,(manhattan(nb,goal),nb))
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0


def weighted_astar_search(grid,start,goal,cap,risk_map=None,weight=1.5):
    t0=time.perf_counter()
    pq=[(manhattan(start,goal)*weight,0,start)]
    g={start:0}
    came={start:None}
    visited=set()
    expansions=0
    while pq:
        f,cost,cur=heapq.heappop(pq)
        if cur in visited: continue
        visited.add(cur)
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            ng=cost+1
            if nb not in g or ng<g[nb]:
                g[nb]=ng
                came[nb]=cur
                heapq.heappush(pq,(ng + weight*manhattan(nb,goal), ng, nb))
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0


def chance_constrained_astar_search(grid,start,goal,cap,risk_map=None,risk_budget=None):
    """Chance-constrained / constrained shortest path formulation."""
    t0=time.perf_counter()
    if risk_map is None:
        return astar_search(grid,start,goal,cap,risk_map)

    if risk_budget is None:
        risk_budget = len(grid) * 30

    start_risk = risk_map[start[1]][start[0]]
    pq=[(manhattan(start,goal),0,start,start_risk)]
    best={(start,start_risk):0}
    came={(start,start_risk):None}
    expansions=0

    def reconstruct_state(came,state):
        path=[]
        while state is not None:
            node,_ = state
            path.append(node)
            state=came[state]
        path.reverse()
        return path

    while pq:
        f,cost,cur,risk = heapq.heappop(pq)
        state=(cur,risk)
        if best.get(state, float('inf')) < cost:
            continue
        expansions+=1
        if cur==goal:
            path=reconstruct_state(came,state)
            path_risk=sum(risk_map[y][x] for x,y in path)
            return len(path),expansions,1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            new_risk = risk + risk_map[nb[1]][nb[0]]
            if new_risk > risk_budget:
                continue
            ng = cost + 1
            new_state = (nb,new_risk)
            if ng < best.get(new_state, float('inf')):
                best[new_state] = ng
                came[new_state] = state
                heapq.heappush(pq,(ng + manhattan(nb,goal), ng, nb, new_risk))
        if expansions>cap: break
    return 0,expansions,0,0,(time.perf_counter()-t0)*1000,0


def cvar_astar_search(grid,start,goal,cap,risk_map=None,risk_weight=0.5,risk_threshold=None):
    """CVaR-style risk-aware search using a risk threshold penalty."""
    t0=time.perf_counter()
    if risk_map is None:
        return astar_search(grid,start,goal,cap,risk_map)

    if risk_threshold is None:
        risk_threshold = len(grid) * 15

    start_risk = risk_map[start[1]][start[0]]
    pq=[(manhattan(start,goal) + risk_weight * max(0, start_risk - risk_threshold), 0, start, start_risk)]
    best={(start,start_risk):0}
    came={(start,start_risk):None}
    expansions=0

    def reconstruct_state(came,state):
        path=[]
        while state is not None:
            node,_ = state
            path.append(node)
            state=came[state]
        path.reverse()
        return path

    while pq:
        f,cost,cur,risk = heapq.heappop(pq)
        state=(cur,risk)
        if best.get(state, float('inf')) < cost:
            continue
        expansions+=1
        if cur==goal:
            path=reconstruct_state(came,state)
            path_risk=sum(risk_map[y][x] for x,y in path)
            return len(path),expansions,1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            new_risk = risk + risk_map[nb[1]][nb[0]]
            ng = cost + 1
            penalty = risk_weight * max(0, new_risk - risk_threshold)
            new_state = (nb,new_risk)
            if ng < best.get(new_state, float('inf')):
                best[new_state] = ng
                came[new_state] = state
                heapq.heappush(pq,(ng + manhattan(nb,goal) + penalty, ng, nb, new_risk))
        if expansions>cap: break
    return 0,expansions,0,0,(time.perf_counter()-t0)*1000,0


def risk_aware_astar_search(grid,start,goal,cap,risk_map=None,risk_weight=0.75):
    t0=time.perf_counter()
    pq=[(manhattan(start,goal) + (risk_map[start[1]][start[0]] * risk_weight if risk_map else 0),0,start)]
    g={start:0}
    came={start:None}
    visited=set()
    expansions=0
    while pq:
        f,cost,cur=heapq.heappop(pq)
        if cur in visited: continue
        visited.add(cur)
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            step_cost = 1 + (risk_weight * (risk_map[nb[1]][nb[0]] if risk_map else 0))
            ng = cost + step_cost
            if nb not in g or ng < g[nb]:
                g[nb] = ng
                came[nb] = cur
                heapq.heappush(pq,(ng + manhattan(nb,goal), ng, nb))
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0


def risk_aware_dijkstra_search(grid,start,goal,cap,risk_map=None,risk_weight=0.75):
    t0=time.perf_counter()
    pq=[(0,start)]
    dist={start:0}
    came={start:None}
    visited=set()
    expansions=0
    while pq:
        d,cur=heapq.heappop(pq)
        if cur in visited: continue
        visited.add(cur)
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            step_cost = 1 + (risk_weight * (risk_map[nb[1]][nb[0]] if risk_map else 0))
            nd = d + step_cost
            if nb not in dist or nd < dist[nb]:
                dist[nb] = nd
                came[nb] = cur
                heapq.heappush(pq,(nd,nb))
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0


def risk_greedy_search(grid,start,goal,cap,risk_map=None,risk_weight=0.5):
    t0=time.perf_counter()
    start_risk = risk_map[start[1]][start[0]] if risk_map else 0
    pq=[(manhattan(start,goal) + risk_weight * start_risk, start)]
    came={start:None}
    visited=set()
    seen={start}
    expansions=0
    while pq:
        _,cur=heapq.heappop(pq)
        if cur in visited: continue
        visited.add(cur)
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            if nb not in seen:
                seen.add(nb)
                came[nb]=cur
                heuristic = manhattan(nb,goal) + (risk_weight * (risk_map[nb[1]][nb[0]] if risk_map else 0))
                heapq.heappush(pq,(heuristic,nb))
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0


def astar_search(grid,start,goal,cap,risk_map=None):
    t0=time.perf_counter()
    pq=[(manhattan(start,goal),0,start)]
    g={start:0}
    came={start:None}
    visited=set()
    expansions=0
    while pq:
        f,cost,cur=heapq.heappop(pq)
        if cur in visited: continue
        visited.add(cur)
        expansions+=1
        if cur==goal:
            path=reconstruct(came,start,goal)
            path_risk=sum(risk_map[y][x] for x,y in path) if risk_map else 0
            return len(path),len(visited),1,0,(time.perf_counter()-t0)*1000,path_risk
        for nb in neighbors(cur,grid):
            ng=cost+1
            if nb not in g or ng<g[nb]:
                g[nb]=ng
                came[nb]=cur
                heapq.heappush(pq,(ng+manhattan(nb,goal),ng,nb))
        if expansions>cap: break
    return 0,len(visited),0,0,(time.perf_counter()-t0)*1000,0

def zen_path_search_optimized(grid, start, goal, cap, risk_map, prefer='local', base_thr=None):
    n = len(grid)
    sx, sy = start
    gx, gy = goal
    
    # Quick bounds check / sanity check
    if grid[sy][sx] != 0 or grid[gy][gx] != 0:
        return 0, 0, 0, 0, 0.0, 0.0

    t0 = time.perf_counter()
    g = {start: 0.0}
    risk_so_far = {start: 0.0}
    came = {start: None}
    closed = set()
    expansions = 0
    hesitations = 0  

    # Inline helper macro for priority scoring to minimize scope lookups
    def get_priority(node):
        f = g[node] + (abs(node[0] - gx) + abs(node[1] - gy))
        if prefer == 'path':
            risk_key = risk_so_far[node]
        else:
            risk_key = risk_map[node[1]][node[0]]
        
        if base_thr is not None:
            risk_key = 1 if risk_key > base_thr else 0
        return (f, risk_key)

    pq = [(get_priority(start), start)]

    while pq and expansions < cap:
        _, cur = heapq.heappop(pq)
        if cur in closed:
            continue
        closed.add(cur)
        expansions += 1

        # Optimization: Admissible heuristics guarantee first-pop optimality for uniform cost
        if cur == goal:
            # Reconstruct path
            path = []
            v = cur
            while v is not None:
                path.append(v)
                v = came[v]
            path.reverse()
            
            path_risk = sum(risk_map[y][x] for x, y in path)
            runtime = (time.perf_counter() - t0) * 1000
            return len(path), expansions, 1, hesitations, runtime, path_risk

        x, y = cur
        # Flattened directional steps to eliminate nested loop structures
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nx, ny = x + dx, y + dy
            if 0 <= nx < n and 0 <= ny < n and grid[ny][nx] == 0:
                nb = (nx, ny)
                ng = g[cur] + 1.0
                
                if nb not in g or ng < g[nb]:
                    g[nb] = ng
                    came[nb] = cur
                    if prefer == 'path':
                        risk_so_far[nb] = risk_so_far[cur] + risk_map[ny][nx]
                    heapq.heappush(pq, (get_priority(nb), nb))

    runtime = (time.perf_counter() - t0) * 1000
    return 0, expansions, 0, hesitations, runtime, 0.0

ALGO_FUNCS=[
    ("ZEN", zen_path_search_optimized),
    ("A*", astar_search),
    ("Weighted A*", weighted_astar_search),
    ("Chance-Constrained A*", chance_constrained_astar_search),
    ("CVaR A*", cvar_astar_search),
    ("Risk-Penalized A*", risk_aware_astar_search),
    ("Risk-Penalized Dijkstra", risk_aware_dijkstra_search),
    ("Risk-Penalized Greedy", risk_greedy_search),
    ("BFS", bfs_search),
    ("DFS", dfs_search),
    ("Dijkstra", dijkstra_search),
    ("Greedy", greedy_search),
]

def run_on_single_map(args):
    map_index, seed, grid_size, base_prob, cluster_prob, max_expansions_factor=args
    try:
        grid=make_risky_grid_safe(grid_size,base_prob,cluster_prob,seed)
        risk_map=precompute_risk_map(grid)
        start=(0,0)
        goal=(grid_size-1,grid_size-1)
        cap=grid_size*grid_size*max_expansions_factor
        rows=[]
    
        for name,func in ALGO_FUNCS:
            algo_cap = cap * cap_multipliers.get(name,1)
            try:
                res=func(grid,start,goal,algo_cap,risk_map=risk_map)
            except:
                res=(0,0,0,0,0.0,0)
            path_len,visited,success,hes,tms,path_risk=res
            rows.append({
                "Algorithm":name,"MapID":map_index,"Seed":seed,
                "Path_Length":int(path_len),"Visited":int(visited),
                "Success":int(bool(success)),"Hesitations":int(hes),
                "Time_ms":float(tms),"Path_Risk_Score":float(path_risk)
            })
        return rows
    except Exception as e:
        return [{"Algorithm":"ERROR","MapID":map_index,"Seed":seed,
                 "Path_Length":0,"Visited":0,"Success":0,"Hesitations":0,
                 "Time_ms":0.0,"Path_Risk_Score":0.0,"Error":str(e)}]

def run_benchmark(num_maps, grid_size, base_prob, cluster_prob, workers, seed_base, max_expansions_factor):
    start_time=time.perf_counter()
    os.makedirs(".",exist_ok=True)
    tasks=[(i,seed_base+i,grid_size,base_prob,cluster_prob,max_expansions_factor) for i in range(1,num_maps+1)]
    print(f"Starting benchmark: {num_maps} maps, size={grid_size}, base_prob={base_prob}, cluster_prob={cluster_prob}, workers={workers}")
    results_rows=[]
    with mp.Pool(processes=workers) as pool:
        it=pool.imap_unordered(run_on_single_map,tasks)
        collected=0
        last_print=time.time()
        for row_group in it:
            results_rows.extend(row_group)
            collected+=1
            if collected%10==0 or time.time()-last_print>5:
                elapsed=time.perf_counter()-start_time
                print(f"  -> Completed {collected}/{num_maps} maps -- elapsed {elapsed:.1f}s")
                last_print=time.time()
    total_time=time.perf_counter()-start_time
    print(f"All maps processed in {total_time:.1f}s. Writing CSV/summary...")

    fieldnames=["Algorithm","MapID","Seed","Path_Length","Visited","Success","Hesitations","Time_ms","Path_Risk_Score"]
    with open(RESULTS_CSV,"w",newline="") as f:
        writer=csv.DictWriter(f,fieldnames=fieldnames)
        writer.writeheader()
        for r in results_rows:
            writer.writerow({k:r.get(k,0) for k in fieldnames})
    print(f"Wrote {RESULTS_CSV} ({len(results_rows)} rows)")

    try:
        df=pd.read_csv(RESULTS_CSV)
        summary=df.groupby("Algorithm").agg(
            Mean_Path=("Path_Length","mean"),
            Std_Path=("Path_Length","std"),
            Mean_Visited=("Visited","mean"),
            Std_Visited=("Visited","std"),
            Success_Rate=("Success","mean"),
            Mean_Hesitations=("Hesitations","mean"),
            Mean_Time_ms=("Time_ms","mean"),
            Mean_Path_Risk=("Path_Risk_Score","mean"),
            Trials=("MapID","count")
        ).reset_index()
        if "A*" in summary["Algorithm"].values:
            arow=summary[summary["Algorithm"]=="A*"].iloc[0]
            base_path=arow["Mean_Path"]
            base_risk=arow["Mean_Path_Risk"]
            base_time=arow["Mean_Time_ms"]
            base_visited=arow["Mean_Visited"]
            summary["Path_vs_A*"] = summary["Mean_Path"]/base_path
            summary["Risk_vs_A*"] = summary["Mean_Path_Risk"]/base_risk
            summary["Time_vs_A*"] = summary["Mean_Time_ms"]/base_time
            summary["Visited_vs_A*"] = summary["Mean_Visited"]/base_visited
        summary.to_csv(SUMMARY_CSV,index=False)
        print(f"Wrote {SUMMARY_CSV}")

        sns.set_theme(style="darkgrid")
        fig, axes = plt.subplots(2, 3, figsize=(18,10))
        metrics=[
            ("Mean_Path","Average Path Length"),
            ("Mean_Visited","Average Nodes Visited"),
            ("Success_Rate","Success Rate"),
            ("Mean_Time_ms","Average Time (ms)"),
            ("Mean_Path_Risk","Average Path Risk Score")
        ]
        axes_flat=axes.flatten()
        for i,(col,title) in enumerate(metrics):
            ax=axes_flat[i]
            if col=="Success_Rate":
                vals=summary[col]*100.0
                ax.bar(summary["Algorithm"],vals)
                ax.set_ylabel("Percent (%)")
            else:
                ax.bar(summary["Algorithm"],summary[col])
            ax.set_title(title)
            ax.tick_params(axis='x',rotation=20)
        axes_flat[5].set_visible(False)
        plt.tight_layout()
        plt.savefig(PLOTS_PNG)
        print(f"Wrote {PLOTS_PNG}")
    except Exception as e:
        print("Failed to produce summary/plots:", e)
    print("✅ Benchmark finished.")

def parse_args():
    p=argparse.ArgumentParser(description="Benchmark on Risky Maps: ZEN vs Classic Algorithms.")
    p.add_argument("--maps","-m",type=int,default=DEFAULT_MAPS)
    p.add_argument("--size","-s",type=int,default=DEFAULT_SIZE)
    p.add_argument("--base-prob",type=float,default=DEFAULT_BASE_PROB)
    p.add_argument("--cluster-prob",type=float,default=DEFAULT_CLUSTER_PROB)
    p.add_argument("--workers","-w",type=int,default=DEFAULT_WORKERS)
    p.add_argument("--seed",type=int,default=BASE_SEED)
    p.add_argument("--cap-factor",type=int,default=MAX_EXPANSIONS_FACTOR)
    return p.parse_args()

if __name__=="__main__":
    args=parse_args()
